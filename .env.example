# Copy to .env and adjust. Never commit real secrets.

# --- General ---
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://localhost:8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Salt for hashed visitor IPs. Generate the same way as SECRET_KEY.
IP_HASH_PEPPER=change-me-too

# --- Database ---
# Local docker compose value:
DATABASE_URL=postgresql+psycopg://linkshort:linkshort@localhost:5432/linkshort
# For a quick run without PostgreSQL:
# DATABASE_URL=sqlite:///./links.db

# --- Cache (optional) ---
# Leave empty to use the built-in in-process cache.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Limits ---
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
SHORT_CODE_LENGTH=7
MAX_URL_LENGTH=2048

# --- HTTP ---
# Comma-separated list or JSON array, e.g. ["https://example.com"]
CORS_ORIGINS=[]
# Set to true when running behind a trusted reverse proxy (Render, Fly, nginx).
TRUSTED_PROXY=false
